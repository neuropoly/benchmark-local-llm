# Settings for the lab vLLM server on tassan. Sourced by setup_vllm.sh, serve_vllm.sh, status.sh.
# Everything lives under LLMBENCH; nothing is installed system-wide.

LLMBENCH=${LLMBENCH:-$HOME/llm-bench}

# Default model (Hugging Face repo) and the short name clients ask for (no "/" so Claude Code accepts it).
# Qwen3.6-27B dense in FP8 (~28 GB), thinking model. SWE-bench Verified 77.2 (vendor) vs 70.6 for the
# 80B coder; slower per user (all 27B read per token) but batches well and leaves ~55 GB for context.
MODEL=Qwen/Qwen3.6-27B-FP8
SERVED_NAME=qwen3.6-27b
TOOL_PARSER=qwen3_coder
EXTRA_ARGS="--reasoning-parser qwen3"
# To serve another model, don't edit the lines above: run  bash switch_model.sh  (models in models.conf).
# It writes its choice to $LLMBENCH/model.env, outside lab_server/ so redeploying the scripts keeps it,
# and that file overrides the four lines above.
if [ -r "$LLMBENCH/model.env" ]; then source "$LLMBENCH/model.env"; fi

# The card we use (nvidia-smi index). Every server, check and benchmark follows it.
GPU=1
# Lab rule (intranet "resource-sharing"): open tmux, then set_slot <n> matching the booked GPU, then
# the venv. set_slot only confines CPU/RAM (tassan: slots 0-1, ~46 GB RAM, 20 cores each); it does NOT
# set CUDA_VISIBLE_DEVICES, the serve scripts export it from GPU. Book the GPU on the lab calendar.
SLOT_CMD="set_slot $GPU"
PORT=8000                      # bound to 127.0.0.1 only, reached through SSH tunnels
# PDFs: vLLM rejects the "document" blocks Claude Code sends for PDFs, so a small proxy (doc_proxy.py)
# listens on PORT and turns them into text + page images; vLLM itself then listens on VLLM_PORT.
# DOC_PROXY=0 puts vLLM back on PORT directly (PDFs then fail again).
DOC_PROXY=1
VLLM_PORT=8010
PDF_PAGE_IMAGES=auto           # page images for figures: auto (if the model has a vision encoder), 1, 0
GPU_UTIL=0.90                  # fraction of the card vLLM may take (weights + KV cache)
MAX_MODEL_LEN=131072           # max context per request
MAX_NUM_SEQS=16                # max requests decoded together
# Parallel kernel compilations on first start (FlashInfer reads MAX_JOBS). The slot has ~46 GB of RAM.
# Most kernels take ~3 GB to compile, but the MoE grouped-GEMM ones take 5-7 GB: on 2026-10-07, 8 of
# those at once (51 GB) swapped for 3 h at 1% CPU. 4 keeps the worst case around 28 GB.
JIT_JOBS=4
STARTUP_TIMEOUT=2700           # seconds serve_vllm.sh waits; the first start compiles FlashInfer kernels (>15 min)

# Leave empty to take the latest release; pin (e.g. 0.30.0) once a version is known to work.
VLLM_VERSION=0.31.0              # installed and CUDA-checked on tassan 2026-10-07

export HF_HOME=$LLMBENCH/hf
export CUDA_DEVICE_ORDER=PCI_BUS_ID   # CUDA numbers cards like nvidia-smi
